# Salin file ini menjadi .env lalu isi nilai sesuai lingkungan Anda.
# JANGAN commit .env — file ini hanya template placeholder.
# Baca app/config.py untuk daftar lengkap pengaturan.

# Kunci API Google Gemini (wajib untuk fitur AI). Tanpa ini,
# route Gemini (/test-ai, /simplify-material, /generate-quiz, dll) mengembalikan 503.
GEMINI_API_KEY=your_gemini_api_key

# Model Gemini yang dipakai. Default: models/gemini-3.6-flash.
# Jika model utama sedang overload (503), coba ganti, mis.:
#   models/gemini-3.6-flash-lite
GEMINI_MODEL=models/gemini-3.6-flash

# Secret untuk menandatangani JWT. Gunakan string acak panjang, jangan dipakai di produksi.
JWT_SECRET=generate-long-random-string

# Masa berlaku token akses dalam menit.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Lokasi database.
# MySQL (Laragon): mysql+pymysql://root:@localhost:3306/vocalearn
# SQLite (fallback): sqlite:///./vocalearn.db
DATABASE_URL=mysql+pymysql://root:@localhost:3306/vocalearn
